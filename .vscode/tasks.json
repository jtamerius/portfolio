{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Script from Root",
            "type": "shell",
            "command": "python ${file}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}